{
  "name": "@local/sim-advisor-workbench",
  "version": "0.2.63",
  "private": true,
  "type": "module",
  "description": "A local simulation planning workbench, knowledge libraries and the current DSH conversation.",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "service.js",
    "dependency-profile.js",
    "offline-setup.js",
    "offline-initialize.mjs",
    "config.js",
    "config-ui.js",
    "client.js",
    "vendor/",
    "bridge/",
    "runtime/",
    "CONTENTS.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test service.test.js test/*.test.js"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
